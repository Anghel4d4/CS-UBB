%Problema 2.47
clc

n = 80;



m=10;
A= 5*diag(ones(1,m))-diag(ones(1,m-1),1)-diag(ones(1,m-1),-1);
b=[4;3*ones(m-2,1);4];
x0=A\b
x1=rezolvaGaussSeidel(A,b,1e-5)
x2=rezolvaJacobi(A,b,1e-5)
x3=rezolvaSOR(A,b,0.5,1e-5)


n = 80;

A = diag((1:n)*2)+ diag((1:n-2)*0.5,2)+diag((3:n)*0.5,-2) ...
          + diag((1:n-4)*0.25,4)+ diag((5:n)*0.25,-4);

disp(A)