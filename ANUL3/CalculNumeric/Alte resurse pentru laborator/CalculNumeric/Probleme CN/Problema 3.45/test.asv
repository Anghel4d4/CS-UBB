clc 
x=[1.02 .95 .87 .77 .67 .56 .44 .30 .16 .01]';
y=[0.39 .32 .27 .22 .18 .15 .13 .12 .13 .15]';

%nEcuatii=10;

A=zeros(10,5);
A(:,1)=x.^2;
A(:,2)=x.*y;
A(:,3)=y.^2;
A(:,4)=x;
A(:,5)=y;

b=-ones(10,1);

coef=A\b;
a=coef(1);
b=coef(2);
c=coef(3);
d=coef(4);
e=coef(5);

% [a b c d e] = coef;

 plot(x,y,'o');
 hold on
 contour(A*coef-b)