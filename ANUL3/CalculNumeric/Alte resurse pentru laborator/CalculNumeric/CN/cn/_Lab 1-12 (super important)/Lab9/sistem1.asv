function a=sistem1(x,y)
n=length(x)-1;
M=zeros(4*n);
N=[1:4*n];
%ec1
M(1,1) = x(1)^3;
M(1,2)= x(1)^2;
M(1,3)=x(1);
M(1,4) = 1;
N(1)=y(1);

%ec2
M(2,1)=6*x(1);
M(2,2) = 2;
N(2)=0;
for i=1:n-1
    %ec 4i-1
    M(4*i-1, 1)=x(i+1)^3;
    M(4*i-1, 2)=x(i+1)^2;
    M(4*i-1, 3)=x(i+1);
    M(4*i-1, 4)=1;
    N(2)=0;
    %ec 4i
    M(4*i, 1)=3*x(i+1)^2;
    M(4*i, 2)=2*x(i+1);
    M(4*i, 3)=1;
    M(4*i, 4)=-3*x(i+1)^2;
    M(4*i, 5)=-2*x(i+1);
    M(4*i, 6)=-1;
    %ec 4i+1
    M(4*i+1, 1)=6*x(i+1);
    M(4*i+1, 2)=2;
    M(4*i+1, 3)=-6*x(i+1);
    M(4*i+1, 4)=2;
    %ec 4i+2
    M(4*i+2, 1)=x(i+1)^3;
    M(4*i+2, 2)=x(i+1)^2;
    M(4*i+2, 3)=x(i+1);
    M(4*i+2, 3)=1;
end
%ec 4n-1
M(4*n-1,1)=6*x(n-1);
M(4*n-1,2)=2;
%ec 4n
M(4*n,1) = x(n+1)^3;
M(4*n,2)=x(n+1)^2;
M(4*n, 3)=x(n+1);
M(4*n,4) = 1;


